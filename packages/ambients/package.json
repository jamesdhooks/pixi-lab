{
  "name": "@hooksjam/pixi-lab-ambients",
  "version": "0.1.0",
  "description": "Ambient visual layers for pixi-lab",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
